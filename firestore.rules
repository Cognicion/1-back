rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function accountIsActive(uid) {
      return !exists(/databases/$(database)/documents/accountDeletionTombstones/$(uid));
    }

    function signedIn() {
      return request.auth != null && accountIsActive(request.auth.uid);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() &&
        currentUserProfile().get("rol", "") == "admin";
    }

    function isMedico() {
      return signedIn() &&
        currentUserProfile().get("rol", "") == "medico";
    }

    function isPsicologo() {
      return signedIn() &&
        currentUserProfile().get("rol", "") == "psicologo";
    }

    function isEnfermeriaSaludMental() {
      return signedIn() &&
        currentUserProfile().get("rol", "") == "enfermeria_salud_mental";
    }

    function isPersonalSalud() {
      return isMedico() || isPsicologo() || isEnfermeriaSaludMental() || isAdmin();
    }

    function isProfesionalClinico() {
      return signedIn()
        && ["medico", "psicologo", "enfermeria_salud_mental"]
          .hasAny([currentUserProfile().get("rol", "")]);
    }

    function isPaciente(data) {
      return data.get("rol", "") == "paciente";
    }

    function isActivePatientRecord(data) {
      return isPaciente(data)
        && !(data.get("estado", "") == "vinculado" && data.get("vinculadoA", "") != "");
    }

    function isFreeProfessional() {
      return currentUserProfile().get("planCuentaProfesional", "") == "profesional_gratuito"
        || currentUserProfile().get("modalidadRegistroProfesional", "") == "gratuita";
    }

    function validPatientQuotaAssignment(patientUid) {
      return exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)/patientQuotaAssignments/$(patientUid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)/patientQuotaAssignments/$(patientUid)
        ).data.get("estado", "") == "activo";
    }

    function professionalPlanAllowsPatient(patientUid) {
      return !isFreeProfessional() || validPatientQuotaAssignment(patientUid);
    }

    function patientHasDirectProfessional(patientData) {
      return [
        patientData.get("creadoPor", ""),
        patientData.get("ownerUid", ""),
        patientData.get("createdByUid", ""),
        patientData.get("medicoUid", ""),
        patientData.get("uidMedico", ""),
        patientData.get("medicoTratanteUid", ""),
        patientData.get("medicoTratanteUID", ""),
        patientData.get("medicoTratanteId", ""),
        patientData.get("idMedico", ""),
        patientData.get("professionalUid", "")
      ].hasAny([request.auth.uid]);
    }

    function patientHasProfessionalInArray(patientData) {
      return patientData.get("medicosAutorizados", []).hasAny([request.auth.uid])
        || patientData.get("medicosAutorizadosUid", []).hasAny([request.auth.uid])
        || patientData.get("profesionalesAutorizados", []).hasAny([request.auth.uid])
        || patientData.get("profesionalesAutorizadosIds", []).hasAny([request.auth.uid])
        || patientData.get("medicosAsignados", []).hasAny([request.auth.uid])
        || patientData.get("equipoClinico", []).hasAny([request.auth.uid])
        || patientData.get("equipoClinicoIds", []).hasAny([request.auth.uid])
        || patientData.get("clinicosAutorizados", []).hasAny([request.auth.uid]);
    }

    function patientPermissionAllows(patientUid, patientData, permissionField) {
      return patientData.get("permisosMedicos", {})
          .get(request.auth.uid, {}).get(permissionField, false) == true
        || (
          exists(
            /databases/$(database)/documents/usuarios/$(patientUid)/permisosMedicos/$(request.auth.uid)
          )
          && get(
            /databases/$(database)/documents/usuarios/$(patientUid)/permisosMedicos/$(request.auth.uid)
          ).data.get(permissionField, false) == true
        );
    }

    function professionalBaseAllowsPatient(patientUid, patientData) {
      return isProfesionalClinico()
        && isActivePatientRecord(patientData)
        && professionalPlanAllowsPatient(patientUid);
    }

    function professionalCanReadPatient(patientUid, patientData) {
      return professionalBaseAllowsPatient(patientUid, patientData)
        && (
          patientHasDirectProfessional(patientData)
          || patientHasProfessionalInArray(patientData)
          || patientPermissionAllows(patientUid, patientData, "lectura")
        );
    }

    function professionalCanEditPatient(patientUid, patientData) {
      return professionalBaseAllowsPatient(patientUid, patientData)
        && (
          patientHasDirectProfessional(patientData)
          || patientPermissionAllows(patientUid, patientData, "editarPaciente")
        );
    }

    function professionalCanAddPatientNotes(patientUid, patientData) {
      return professionalBaseAllowsPatient(patientUid, patientData)
        && (
          patientHasDirectProfessional(patientData)
          || patientPermissionAllows(patientUid, patientData, "agregarNotas")
        );
    }

    function professionalCanAdminPatient(patientUid, patientData) {
      return professionalBaseAllowsPatient(patientUid, patientData)
        && (
          patientHasDirectProfessional(patientData)
          || patientPermissionAllows(patientUid, patientData, "administrarPermisos")
        );
    }

    function patientProfile(patientUid) {
      return get(/databases/$(database)/documents/usuarios/$(patientUid)).data;
    }

    function isPatientNoteCollection(subcollection) {
      return [
        "notas",
        "notasMedicas",
        "notasRapidas",
        "notasFlotantes"
      ].hasAny([subcollection]);
    }

    function isCanonicalAdhdData(data) {
      return data.get("protocolId", "") == "cognicion-tdah-multicomponente";
    }

    function validLegacyRehabilitationResult(data) {
      return !isCanonicalAdhdData(data)
        && !data.keys().hasAny([
          "programId",
          "protocolId",
          "protocolVersion",
          "persistenceSchemaVersion",
          "references"
        ]);
    }

    function validAdhdMetadata(data, programId) {
      return data.keys().hasAll([
          "programId",
          "persistenceSchemaVersion",
          "protocolId",
          "protocolVersion"
        ])
        && data.get("programId", "") == programId
        && data.get("programId", "") is string
        && data.get("programId", "") != ""
        && data.get("persistenceSchemaVersion", "") is string
        && data.get("persistenceSchemaVersion", "") != ""
        && data.get("protocolId", "") == "cognicion-tdah-multicomponente"
        && data.get("protocolVersion", "") is string
        && data.get("protocolVersion", "") != "";
    }

    function validAdhdEvaluationCreate(programId, evaluationId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.keys().hasAll([
          "id",
          "assessmentId",
          "phase",
          "status",
          "batteryType",
          "taskIds",
          "resultIds",
          "validResultIds",
          "formConfiguration",
          "createdAtIso"
        ])
        && request.resource.data.get("id", "") == evaluationId
        && request.resource.data.get("assessmentId", "") == evaluationId
        && request.resource.data.get("status", "") == "in_progress"
        && request.resource.data.get("taskIds", []) is list
        && request.resource.data.get("resultIds", []) is list
        && request.resource.data.get("validResultIds", []) is list;
    }

    function adhdEvaluationReferencesAppendOnly() {
      return request.resource.data.get("resultIds", []) is list
        && request.resource.data.get("resultIds", []).hasAll(resource.data.get("resultIds", []))
        && request.resource.data.get("taskResultIds", []) is list
        && request.resource.data.get("taskResultIds", []).hasAll(resource.data.get("taskResultIds", []))
        && request.resource.data.get("validResultIds", []) is list
        && request.resource.data.get("validResultIds", []).hasAll(resource.data.get("validResultIds", []));
    }

    function validPatientAdhdEvaluationTransition() {
      return request.resource.data.get("status", "") == resource.data.get("status", "")
        || (
          resource.data.get("status", "") == "in_progress"
          && ["paused", "completed_pending_profile"]
            .hasAny([request.resource.data.get("status", "")])
        )
        || (
          resource.data.get("status", "") == "paused"
          && ["in_progress", "completed_pending_profile"]
            .hasAny([request.resource.data.get("status", "")])
        );
    }

    function validClinicalAdhdEvaluationTransition() {
      return validPatientAdhdEvaluationTransition()
        || (
          resource.data.get("status", "") == "completed_pending_profile"
          && request.resource.data.get("status", "") == "completed"
        );
    }

    function validAdhdEvaluationUpdate(programId, evaluationId, clinical) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.get("id", "") == evaluationId
        && request.resource.data.get("assessmentId", "") == evaluationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "resultIds",
          "taskResultIds",
          "validResultIds",
          "status",
          "completedAt",
          "pausedAt",
          "context",
          "quality",
          "postBlockSelfReports",
          "profileId",
          "updatedAt",
          "pendingSync"
        ])
        && adhdEvaluationReferencesAppendOnly()
        && (
          (
            clinical
            && (
              resource.data.get("profileId", "") == ""
              || request.resource.data.get("profileId", "") == resource.data.get("profileId", "")
            )
          )
          || (
            !clinical
            && request.resource.data.get("profileId", "") == resource.data.get("profileId", "")
          )
        )
        && (
          (clinical && validClinicalAdhdEvaluationTransition())
          || (!clinical && validPatientAdhdEvaluationTransition())
        );
    }

    function validAdhdGoalCreate(programId, goalId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.keys().hasAll([
          "id",
          "action",
          "context",
          "frequency",
          "target",
          "reviewDate",
          "active",
          "progress",
          "createdAt"
        ])
        && request.resource.data.get("id", "") == goalId
        && request.resource.data.get("active", false) == true
        && request.resource.data.get("progress", []) is list;
    }

    function adhdGoalReferencesAppendOnly() {
      return request.resource.data.get("resultIds", []) is list
        && request.resource.data.get("resultIds", []).hasAll(resource.data.get("resultIds", []))
        && request.resource.data.get("progress", []) is list
        && request.resource.data.get("progress", []).hasAll(resource.data.get("progress", []));
    }

    function validPatientAdhdGoalUpdate(programId, goalId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.get("id", "") == goalId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "progress",
          "resultIds",
          "updatedAt",
          "pendingSync"
        ])
        && adhdGoalReferencesAppendOnly();
    }

    function validClinicalAdhdGoalUpdate(programId, goalId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.get("id", "") == goalId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "action",
          "context",
          "frequency",
          "target",
          "reviewDate",
          "difficultyId",
          "domains",
          "active",
          "deactivatedAt",
          "reviewSource",
          "progress",
          "resultIds",
          "updatedAt",
          "pendingSync"
        ])
        && adhdGoalReferencesAppendOnly();
    }

    function validAdhdSessionCreate(programId, sessionId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.keys().hasAll([
          "id",
          "sessionId",
          "sessionEngineVersion",
          "schemaVersion",
          "programEngineVersion",
          "status",
          "blocks",
          "transitionLog"
        ])
        && request.resource.data.get("id", "") == sessionId
        && request.resource.data.get("sessionId", "") == sessionId
        && ["not_started", "in_progress"].hasAny([request.resource.data.get("status", "")])
        && request.resource.data.get("blocks", []) is list
        && request.resource.data.get("transitionLog", []) is list
        && validAdhdSessionBlocks(request.resource.data)
        && validAdhdSessionTerminalState(request.resource.data);
    }

    function adhdBlockIsActive(block) {
      return ["in_progress", "paused"].hasAny([block.get("status", "")]);
    }

    function adhdBlockIsFinished(block) {
      return ["completed", "completed_with_incomplete_data"].hasAny([block.get("status", "")])
        || (
          block.get("required", true) == false
          && block.get("status", "") == "skipped"
        );
    }

    function validAdhdBlockShape(block, kind) {
      return block is map
        && block.keys().hasAll(["id", "kind", "required", "status", "attempts"])
        && block.get("id", "") is string
        && block.get("id", "") != ""
        && block.get("kind", "") == kind
        && block.get("required", false) == true
        && block.get("attempts", []) is list
        && [
          "pending",
          "in_progress",
          "paused",
          "completed",
          "completed_with_incomplete_data"
        ].hasAny([block.get("status", "")]);
    }

    function validAdhdCognitiveBlockPayload(block) {
      let result = block.get("result", null);
      return result == null
        || (
          result is map
          && result.keys().hasAll(["resultId", "canonicalSource", "snapshotContainsMetrics"])
          && result.keys().hasOnly([
            "resultId", "taskId", "taskVersion", "metricsVersion", "status", "valid",
            "quality", "canonicalSource", "snapshotContainsMetrics", "completedAtIso"
          ])
          && result.get("resultId", "") is string
          && result.get("resultId", "") != ""
          && result.get("canonicalSource", "") == "usuarios/{patientId}/rehabilitacionResultados/{resultId}"
          && result.get("snapshotContainsMetrics", true) == false
        );
    }

    function validAdhdCurrentBlockPointer(data) {
      let blocks = data.get("blocks", []);
      let current = data.get("currentBlockId", null);
      return (
          current == null
          && !adhdBlockIsActive(blocks[0])
          && !adhdBlockIsActive(blocks[1])
          && !adhdBlockIsActive(blocks[2])
          && !adhdBlockIsActive(blocks[3])
          && !adhdBlockIsActive(blocks[4])
          && !adhdBlockIsActive(blocks[5])
          && !adhdBlockIsActive(blocks[6])
        )
        || (current == blocks[0].get("id", "") && adhdBlockIsActive(blocks[0]))
        || (current == blocks[1].get("id", "") && adhdBlockIsActive(blocks[1]))
        || (current == blocks[2].get("id", "") && adhdBlockIsActive(blocks[2]))
        || (current == blocks[3].get("id", "") && adhdBlockIsActive(blocks[3]))
        || (current == blocks[4].get("id", "") && adhdBlockIsActive(blocks[4]))
        || (current == blocks[5].get("id", "") && adhdBlockIsActive(blocks[5]))
        || (current == blocks[6].get("id", "") && adhdBlockIsActive(blocks[6]));
    }

    function validAdhdSessionBlocks(data) {
      let blocks = data.get("blocks", []);
      return blocks is list
        && blocks.size() == 7
        && validAdhdBlockShape(blocks[0], "activation")
        && validAdhdBlockShape(blocks[1], "cognitive_task")
        && validAdhdBlockShape(blocks[2], "cognitive_task")
        && validAdhdCognitiveBlockPayload(blocks[1])
        && validAdhdCognitiveBlockPayload(blocks[2])
        && validAdhdBlockShape(blocks[3], "metacognition")
        && validAdhdBlockShape(blocks[4], "functional_transfer")
        && validAdhdBlockShape(blocks[5], "self_assessment")
        && validAdhdBlockShape(blocks[6], "feedback")
        && blocks[0].get("id", "") != blocks[1].get("id", "")
        && blocks[0].get("id", "") != blocks[2].get("id", "")
        && blocks[0].get("id", "") != blocks[3].get("id", "")
        && blocks[0].get("id", "") != blocks[4].get("id", "")
        && blocks[0].get("id", "") != blocks[5].get("id", "")
        && blocks[0].get("id", "") != blocks[6].get("id", "")
        && blocks[1].get("id", "") != blocks[2].get("id", "")
        && blocks[1].get("id", "") != blocks[3].get("id", "")
        && blocks[1].get("id", "") != blocks[4].get("id", "")
        && blocks[1].get("id", "") != blocks[5].get("id", "")
        && blocks[1].get("id", "") != blocks[6].get("id", "")
        && blocks[2].get("id", "") != blocks[3].get("id", "")
        && blocks[2].get("id", "") != blocks[4].get("id", "")
        && blocks[2].get("id", "") != blocks[5].get("id", "")
        && blocks[2].get("id", "") != blocks[6].get("id", "")
        && blocks[3].get("id", "") != blocks[4].get("id", "")
        && blocks[3].get("id", "") != blocks[5].get("id", "")
        && blocks[3].get("id", "") != blocks[6].get("id", "")
        && blocks[4].get("id", "") != blocks[5].get("id", "")
        && blocks[4].get("id", "") != blocks[6].get("id", "")
        && blocks[5].get("id", "") != blocks[6].get("id", "")
        && (blocks[1].get("status", "") == "pending" || adhdBlockIsFinished(blocks[0]))
        && (blocks[2].get("status", "") == "pending" || (adhdBlockIsFinished(blocks[0]) && adhdBlockIsFinished(blocks[1])))
        && (blocks[3].get("status", "") == "pending" || (adhdBlockIsFinished(blocks[0]) && adhdBlockIsFinished(blocks[1]) && adhdBlockIsFinished(blocks[2])))
        && (blocks[4].get("status", "") == "pending" || (adhdBlockIsFinished(blocks[0]) && adhdBlockIsFinished(blocks[1]) && adhdBlockIsFinished(blocks[2]) && adhdBlockIsFinished(blocks[3])))
        && (blocks[5].get("status", "") == "pending" || (adhdBlockIsFinished(blocks[0]) && adhdBlockIsFinished(blocks[1]) && adhdBlockIsFinished(blocks[2]) && adhdBlockIsFinished(blocks[3]) && adhdBlockIsFinished(blocks[4])))
        && (blocks[6].get("status", "") == "pending" || (adhdBlockIsFinished(blocks[0]) && adhdBlockIsFinished(blocks[1]) && adhdBlockIsFinished(blocks[2]) && adhdBlockIsFinished(blocks[3]) && adhdBlockIsFinished(blocks[4]) && adhdBlockIsFinished(blocks[5])))
        && validAdhdCurrentBlockPointer(data);
    }

    function validAdhdSessionTerminalState(data) {
      let blocks = data.get("blocks", []);
      let status = data.get("status", "");
      return (
          status != "completed"
          && status != "completed_with_incomplete_data"
        )
        || (
          data.get("currentBlockId", null) == null
          && adhdBlockIsFinished(blocks[0])
          && adhdBlockIsFinished(blocks[1])
          && adhdBlockIsFinished(blocks[2])
          && adhdBlockIsFinished(blocks[3])
          && adhdBlockIsFinished(blocks[4])
          && adhdBlockIsFinished(blocks[5])
          && adhdBlockIsFinished(blocks[6])
          && (
            status != "completed"
            || (
              blocks[0].get("status", "") == "completed"
              && blocks[1].get("status", "") == "completed"
              && blocks[2].get("status", "") == "completed"
              && blocks[3].get("status", "") == "completed"
              && blocks[4].get("status", "") == "completed"
              && blocks[5].get("status", "") == "completed"
              && blocks[6].get("status", "") == "completed"
            )
          )
        );
    }

    function validAdhdBlockTransition(before, after) {
      let beforeStatus = before.get("status", "");
      let afterStatus = after.get("status", "");
      return after.get("id", "") == before.get("id", "")
        && after.get("kind", "") == before.get("kind", "")
        && after.get("required", true) == before.get("required", true)
        && after.get("taskId", null) == before.get("taskId", null)
        && after.get("moduleId", null) == before.get("moduleId", null)
        && after.get("challengeId", null) == before.get("challengeId", null)
        && (
          afterStatus == beforeStatus
          || (beforeStatus == "pending" && ["in_progress", "completed", "completed_with_incomplete_data"].hasAny([afterStatus]))
          || (beforeStatus == "in_progress" && ["paused", "pending", "completed", "completed_with_incomplete_data"].hasAny([afterStatus]))
          || (beforeStatus == "paused" && ["in_progress", "pending"].hasAny([afterStatus]))
        )
        && (
          !["completed", "completed_with_incomplete_data"].hasAny([beforeStatus])
          || after.diff(before).affectedKeys().hasOnly(["result", "postBlockSelfReport", "feedbackSkipped"])
        );
    }

    function validAdhdSessionBlockTransitions() {
      let before = resource.data.get("blocks", []);
      let after = request.resource.data.get("blocks", []);
      return validAdhdBlockTransition(before[0], after[0])
        && validAdhdBlockTransition(before[1], after[1])
        && validAdhdBlockTransition(before[2], after[2])
        && validAdhdBlockTransition(before[3], after[3])
        && validAdhdBlockTransition(before[4], after[4])
        && validAdhdBlockTransition(before[5], after[5])
        && validAdhdBlockTransition(before[6], after[6]);
    }

    function validAdhdSingleBlockMutation() {
      let before = resource.data.get("blocks", []);
      let after = request.resource.data.get("blocks", []);
      return (
          after[0] == before[0]
          && after[1] == before[1]
          && after[2] == before[2]
          && after[3] == before[3]
          && after[4] == before[4]
          && after[5] == before[5]
          && after[6] == before[6]
        )
        || (
          after[0] != before[0]
          && after[1] == before[1]
          && after[2] == before[2]
          && after[3] == before[3]
          && after[4] == before[4]
          && after[5] == before[5]
          && after[6] == before[6]
        )
        || (
          after[0] == before[0]
          && after[1] != before[1]
          && after[2] == before[2]
          && after[3] == before[3]
          && after[4] == before[4]
          && after[5] == before[5]
          && after[6] == before[6]
        )
        || (
          after[0] == before[0]
          && after[1] == before[1]
          && after[2] != before[2]
          && after[3] == before[3]
          && after[4] == before[4]
          && after[5] == before[5]
          && after[6] == before[6]
        )
        || (
          after[0] == before[0]
          && after[1] == before[1]
          && after[2] == before[2]
          && after[3] != before[3]
          && after[4] == before[4]
          && after[5] == before[5]
          && after[6] == before[6]
        )
        || (
          after[0] == before[0]
          && after[1] == before[1]
          && after[2] == before[2]
          && after[3] == before[3]
          && after[4] != before[4]
          && after[5] == before[5]
          && after[6] == before[6]
        )
        || (
          after[0] == before[0]
          && after[1] == before[1]
          && after[2] == before[2]
          && after[3] == before[3]
          && after[4] == before[4]
          && after[5] != before[5]
          && after[6] == before[6]
        )
        || (
          after[0] == before[0]
          && after[1] == before[1]
          && after[2] == before[2]
          && after[3] == before[3]
          && after[4] == before[4]
          && after[5] == before[5]
          && after[6] != before[6]
        );
    }

    function validAdhdSessionTransition() {
      return request.resource.data.get("status", "") == resource.data.get("status", "")
        || (
          resource.data.get("status", "") == "not_started"
          && ["in_progress", "abandoned"].hasAny([request.resource.data.get("status", "")])
        )
        || (
          ["in_progress", "paused"]
            .hasAny([resource.data.get("status", "")])
          && ["in_progress", "paused", "completed", "completed_with_incomplete_data", "abandoned"]
            .hasAny([request.resource.data.get("status", "")])
        );
    }

    function adhdSessionHistoryAppendOnly() {
      return request.resource.data.get("resultIds", []) is list
        && request.resource.data.get("resultIds", []).hasAll(resource.data.get("resultIds", []))
        && request.resource.data.get("taskResultIds", []) is list
        && request.resource.data.get("taskResultIds", []).hasAll(resource.data.get("taskResultIds", []))
        && request.resource.data.get("transitionLog", []) is list
        && request.resource.data.get("transitionLog", []).hasAll(resource.data.get("transitionLog", []));
    }

    function validAdhdSessionUpdate(programId, sessionId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.get("id", "") == sessionId
        && request.resource.data.get("sessionId", "") == sessionId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "blocks",
          "transitionLog",
          "dataQuality",
          "status",
          "hasStarted",
          "startedAt",
          "completedAt",
          "pausedAt",
          "currentBlockId",
          "taskResultIds",
          "resultIds",
          "selfRating",
          "transferStatus",
          "migration",
          "recoveredAfterReload",
          "updatedAt",
          "pendingSync"
        ])
        && request.resource.data.get("blocks", []).size() == resource.data.get("blocks", []).size()
        && validAdhdSessionBlocks(request.resource.data)
        && validAdhdSessionTerminalState(request.resource.data)
        && validAdhdSessionBlockTransitions()
        && validAdhdSingleBlockMutation()
        && adhdSessionHistoryAppendOnly()
        && validAdhdSessionTransition();
    }

    function validAdhdChallengeCreate(programId, challengeId) {
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.keys().hasAll([
          "id", "templateId", "sessionId", "sessionNumber", "label", "domains",
          "status", "ratings", "sourceReports", "linkedGoalIds", "createdAt"
        ])
        && request.resource.data.get("id", "") == challengeId
        && request.resource.data.get("templateId", "") is string
        && request.resource.data.get("templateId", "") != ""
        && request.resource.data.get("sessionId", "") is string
        && request.resource.data.get("sessionId", "") != ""
        && request.resource.data.get("sessionNumber", 0) is int
        && request.resource.data.get("sessionNumber", 0) > 0
        && request.resource.data.get("label", "") is string
        && request.resource.data.get("label", "") != ""
        && request.resource.data.get("domains", []) is list
        && request.resource.data.get("ratings", {}) is map
        && request.resource.data.get("sourceReports", []) is list
        && request.resource.data.get("sourceReports", []).size() == 0
        && request.resource.data.get("linkedGoalIds", []) is list
        && request.resource.data.get("status", "") == "pending";
    }

    function validAdhdChallengeUpdate(programId, challengeId) {
      let beforeStatus = resource.data.get("status", "");
      let afterStatus = request.resource.data.get("status", "");
      return validAdhdMetadata(request.resource.data, programId)
        && request.resource.data.get("id", "") == challengeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "note", "ratings", "sourceReports", "completedAt",
          "resultIds", "updatedAt", "pendingSync"
        ])
        && request.resource.data.get("sourceReports", []) is list
        && request.resource.data.get("resultIds", []) is list
        && request.resource.data.get("resultIds", []).hasAll(resource.data.get("resultIds", []))
        && (
          afterStatus == beforeStatus
          || (beforeStatus == "pending" && ["completed", "partial", "not_completed"].hasAny([afterStatus]))
        )
        && (
          beforeStatus == "pending"
          || request.resource.data.get("sourceReports", []) == resource.data.get("sourceReports", [])
        );
    }

    function validCanonicalAdhdResultCreate(uid, resultId) {
      return validAdhdMetadata(
          request.resource.data,
          request.resource.data.get("programId", "")
        )
        && exists(
          /databases/$(database)/documents/usuarios/$(uid)/rehabilitacionProgramas/$(request.resource.data.programId)
        )
        && request.resource.data.keys().hasAll([
          "idResultado",
          "resultId",
          "taskId",
          "activityId",
          "taskVersion",
          "metricsVersion",
          "metrics",
          "results",
          "references",
          "status",
          "valid",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.get("idResultado", "") == resultId
        && request.resource.data.get("resultId", "") == resultId
        && request.resource.data.get("id", resultId) == resultId
        && request.resource.data.get("taskId", "") is string
        && request.resource.data.get("taskId", "") != ""
        && request.resource.data.get("references", {}) is map
        && request.resource.data.get("metrics", {}) is map
        && request.resource.data.get("results", {}) is map
        && ["completed", "interrupted", "completed_with_incomplete_data"]
          .hasAny([request.resource.data.get("status", "")])
        && request.resource.data.get("valid", false) is bool
        && request.resource.data.get("createdAt", null) == request.time
        && request.resource.data.get("updatedAt", null) == request.time;
    }

    function validCanonicalAdhdFeedbackFields(resultId) {
      return request.resource.data.get("id", resultId) == resultId
        && (
          !resource.data.keys().hasAny(["id"])
          || request.resource.data.get("id", "") == resource.data.get("id", "")
        )
        && (
          !request.resource.data.keys().hasAny(["adaptiveDecision"])
          || request.resource.data.get("adaptiveDecision", {}) is map
        )
        && (
          !request.resource.data.keys().hasAny(["feedback"])
          || request.resource.data.get("feedback", {}) is map
        )
        && (
          !request.resource.data.keys().hasAny(["postBlockSelfReport"])
          || request.resource.data.get("postBlockSelfReport", {}) is map
        )
        && (
          !request.resource.data.keys().hasAny(["feedbackSkipped"])
          || request.resource.data.get("feedbackSkipped", false) is bool
        )
        && (
          !request.resource.data.keys().hasAny(["pendingSync"])
          || request.resource.data.get("pendingSync", false) is bool
        );
    }

    function canonicalAdhdFeedbackIsWriteOnce() {
      return (
          !resource.data.keys().hasAny(["adaptiveDecision"])
          || request.resource.data.get("adaptiveDecision", null) == resource.data.get("adaptiveDecision", null)
        )
        && (
          !resource.data.keys().hasAny(["feedback"])
          || request.resource.data.get("feedback", null) == resource.data.get("feedback", null)
        )
        && (
          !resource.data.keys().hasAny(["postBlockSelfReport"])
          || request.resource.data.get("postBlockSelfReport", null) == resource.data.get("postBlockSelfReport", null)
        )
        && (
          !resource.data.keys().hasAny(["feedbackSkipped"])
          || request.resource.data.get("feedbackSkipped", null) == resource.data.get("feedbackSkipped", null)
        );
    }

    function validCanonicalAdhdResultUpdate(resultId) {
      return isCanonicalAdhdData(resource.data)
        && isCanonicalAdhdData(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "adaptiveDecision",
          "feedback",
          "postBlockSelfReport",
          "feedbackSkipped",
          "id",
          "pendingSync",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.get("createdAt", null) == resource.data.get("createdAt", null)
        && request.resource.data.get("updatedAt", null) == request.time
        && validCanonicalAdhdFeedbackFields(resultId)
        && canonicalAdhdFeedbackIsWriteOnce();
    }

    function validAdhdTelemetryCreate(uid, resultId) {
      let parent = getAfter(
        /databases/$(database)/documents/usuarios/$(uid)/rehabilitacionResultados/$(resultId)
      ).data;
      return isCanonicalAdhdData(parent)
        && validAdhdMetadata(request.resource.data, parent.get("programId", ""))
        && request.resource.data.get("resultId", "") == resultId
        && request.resource.data.get("taskId", "") == parent.get("taskId", "")
        && request.resource.data.get("channel", "") is string
        && request.resource.data.get("blockIndex", -1) is int
        && request.resource.data.get("blockIndex", -1) >= 0
        && request.resource.data.get("totalBlocks", 0) is int
        && request.resource.data.get("totalBlocks", 0) > 0
        && request.resource.data.get("records", []) is list
        && request.resource.data.get("recordCount", -1) == request.resource.data.get("records", []).size()
        && request.resource.data.get("createdAt", null) == request.time;
    }

    function validAdhdTelemetryIdempotentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["createdAt"])
        && (
          request.resource.data.get("createdAt", null) == resource.data.get("createdAt", null)
          || request.resource.data.get("createdAt", null) == request.time
        );
    }

    function hasNoAlternateRoleClaims(data) {
      return !data.keys().hasAny([
        "role",
        "roles",
        "rolUsuario",
        "tipoRol",
        "tipoUsuario",
        "tipoCuenta",
        "tipoProfesional",
        "profesion",
        "profession",
        "especialidad",
        "specialty",
        "cargo",
        "cedula",
        "cedulaProfesional",
        "cedulaEspecialidad",
        "cargoSistema",
        "perfil",
        "perfilClinico",
        "perfilProfesional",
        "professionalProfile",
        "clinicalProfile",
        "capacidades",
        "capabilities",
        "permisos",
        "permisosFormatos",
        "formatPermissions",
        "formatPermissionMetadata",
        "permisosFormatosMetadata",
        "formatosAutorizados",
        "formatosAutorizadosArray",
        "permisosFormatosArray",
        "formatosManualesAsignados",
        "paquetesFormatosAsignados",
        "claims",
        "admin",
        "esAdmin",
        "isAdmin",
        "perfilClinicoHabilitado",
        "clinicalProfileEnabled",
        "perfilMedicoVerificado",
        "medicoVerificado",
        "modalidadRegistroProfesional",
        "planCuentaProfesional",
        "limitePacientes",
        "pacientesEnCuenta"
      ]);
    }

    function hasNoAccountLinkingInternalFields(data) {
      return !data.keys().hasAny([
        "codigoVinculacionActivo",
        "fechaCodigoVinculacion",
        "vinculacionReservaEstado",
        "vinculacionReservaCodigo",
        "vinculacionReservaActorUid",
        "vinculacionReservaAccion",
        "vinculacionReservaDestinoUid",
        "vinculadoA",
        "expedienteVinculadoDesde",
        "fechaVinculacionExpediente"
      ]);
    }

    function accountLinkingInternalFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "codigoVinculacionActivo",
        "fechaCodigoVinculacion",
        "vinculacionReservaEstado",
        "vinculacionReservaCodigo",
        "vinculacionReservaActorUid",
        "vinculacionReservaAccion",
        "vinculacionReservaDestinoUid",
        "vinculadoA",
        "expedienteVinculadoDesde",
        "fechaVinculacionExpediente"
      ]);
    }

    function protectedRoleFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "rol",
        "role",
        "roles",
        "rolUsuario",
        "tipoRol",
        "tipoUsuario",
        "tipoCuenta",
        "tipoProfesional",
        "profesion",
        "profession",
        "cargoSistema",
        "perfil",
        "perfilClinico",
        "perfilProfesional",
        "professionalProfile",
        "clinicalProfile",
        "capacidades",
        "capabilities",
        "permisos",
        "permisosFormatos",
        "formatPermissions",
        "formatPermissionMetadata",
        "permisosFormatosMetadata",
        "formatosAutorizados",
        "formatosAutorizadosArray",
        "permisosFormatosArray",
        "formatosManualesAsignados",
        "paquetesFormatosAsignados",
        "claims",
        "admin",
        "esAdmin",
        "isAdmin",
        "perfilClinicoHabilitado",
        "clinicalProfileEnabled",
        "perfilMedicoVerificado",
        "medicoVerificado",
        "modalidadRegistroProfesional",
        "planCuentaProfesional",
        "limitePacientes",
        "pacientesEnCuenta"
      ]);
    }

    function hasNoProfessionalAssignments(data) {
      return data.get("creadoPor", "") == ""
        && data.get("ownerUid", "") == ""
        && data.get("createdByUid", "") == ""
        && data.get("medicoUid", "") == ""
        && data.get("uidMedico", "") == ""
        && data.get("medicoTratanteUid", "") == ""
        && data.get("medicoTratanteUID", "") == ""
        && data.get("medicoTratanteId", "") == ""
        && data.get("idMedico", "") == ""
        && data.get("professionalUid", "") == ""
        && data.get("medicosAutorizados", []).size() == 0
        && data.get("medicosAutorizadosUid", []).size() == 0
        && data.get("profesionalesAutorizados", []).size() == 0
        && data.get("profesionalesAutorizadosIds", []).size() == 0
        && data.get("medicosAsignados", []).size() == 0
        && data.get("equipoClinico", []).size() == 0
        && data.get("equipoClinicoIds", []).size() == 0
        && data.get("clinicosAutorizados", []).size() == 0
        && !data.keys().hasAny(["permisosMedicos"]);
    }

    function patientAccessFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "creadoPor",
        "ownerUid",
        "createdByUid",
        "medicoUid",
        "uidMedico",
        "medicoTratanteUid",
        "medicoTratanteUID",
        "medicoTratanteId",
        "idMedico",
        "professionalUid",
        "medicosAutorizados",
        "medicosAutorizadosUid",
        "profesionalesAutorizados",
        "profesionalesAutorizadosIds",
        "medicosAsignados",
        "equipoClinico",
        "equipoClinicoIds",
        "clinicosAutorizados",
        "permisosMedicos"
      ]);
    }

    function patientClinicalIdentityFieldsChanged() {
      return isPaciente(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "especialidad",
          "specialty",
          "cargo",
          "cedula",
          "cedulaProfesional",
          "cedulaEspecialidad"
        ]);
    }

    function validSelfPatientCreate(uid) {
      return isSelf(uid)
        && isPaciente(request.resource.data)
        && hasNoAlternateRoleClaims(request.resource.data)
        && hasNoAccountLinkingInternalFields(request.resource.data)
        && hasNoProfessionalAssignments(request.resource.data);
    }

    function validProvisionalPatientCreate(uid) {
      return signedIn()
        && request.auth.uid != uid
        && isPersonalSalud()
        && isPaciente(request.resource.data)
        && request.resource.data.tieneCuenta == false
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.medicoUid == request.auth.uid
        && request.resource.data.creadoPor == request.auth.uid
        && hasNoAlternateRoleClaims(request.resource.data)
        && hasNoAccountLinkingInternalFields(request.resource.data);
    }

    function validSelfProfileUpdate(uid) {
      return isSelf(uid)
        && !protectedRoleFieldsChanged()
        && !accountLinkingInternalFieldsChanged()
        && !patientAccessFieldsChanged()
        && !patientClinicalIdentityFieldsChanged();
    }

    function validClinicalPatientUpdate(uid) {
      return !isSelf(uid)
        && isPaciente(resource.data)
        && isPaciente(request.resource.data)
        && professionalCanEditPatient(uid, resource.data)
        && !protectedRoleFieldsChanged()
        && !accountLinkingInternalFieldsChanged()
        && !patientAccessFieldsChanged();
    }

    /*
     * USUARIOS
     */
    match /usuarios/{uid} {
      // Las cuentas profesionales y los expedientes provisionales se crean
      // mediante callables backend. El cliente solo puede autocrear un perfil
      // paciente sin asignaciones profesionales; las vinculaciones conservan
      // su flujo backend y las cuentas gratuitas no pueden evadir la cuota.
      allow create: if accountIsActive(uid) && validSelfPatientCreate(uid);

      // Los perfiles profesionales continúan disponibles a sesiones autenticadas.
      // Los expedientes de paciente exigen relación clínica y, para el plan
      // gratuito, un slot server-only activo para ese UID.
      allow get: if accountIsActive(uid)
                 && (
                   isSelf(uid)
                   || isAdmin()
                   || (signedIn() && !isPaciente(resource.data))
                   || professionalCanReadPatient(uid, resource.data)
                 );
      allow list: if signedIn()
                  && (
                    isAdmin()
                    || professionalCanReadPatient(uid, resource.data)
                  );

      // Un usuario nunca puede elevar sus propios campos de rol. El flujo
      // administrativo conserva la asignación de rol a terceros ya existente.
      allow update: if accountIsActive(uid)
                    && (validSelfProfileUpdate(uid)
                        || validClinicalPatientUpdate(uid)
                        || (isAdmin() && !isSelf(uid) && !accountLinkingInternalFieldsChanged()));

      allow delete: if accountIsActive(uid) && isAdmin();

      // Mantiene el comportamiento heredado de las subcolecciones existentes,
      // pero excluye los documentos internos administrados por el backend de Mi nube.
      // La agenda contiene datos privados del profesional. El wildcard heredado
      // no debe convertirla en una colección legible por cualquier usuario autenticado.
      match /agenda/{eventoId} {
        allow read: if accountIsActive(uid) && (isSelf(uid) || isAdmin());
        allow write: if accountIsActive(uid) && (isSelf(uid) || isAdmin());
      }

      // Perfiles derivados y revisiones clínicas: solo Cloud Functions/Admin SDK.
      // El resultado computado no puede ser alterado por el navegador.
      match /clinicalPatternProfiles/{document=**} {
        allow read, create, update, delete: if false;
      }

      match /clinicalPatternReviews/{reviewId} {
        allow read, create, update, delete: if false;
      }

      // Programa TDAH: el paciente puede ejecutar y registrar avance, pero no
      // prescribir ni alterar el perfil derivado o el plan clínico.
      match /rehabilitacionProgramas/{programId} {
        allow read: if accountIsActive(uid)
                    && (
                      isSelf(uid)
                      || isAdmin()
                      || professionalCanReadPatient(uid, patientProfile(uid))
                    );
        allow create: if accountIsActive(uid)
                      && (
                        isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                      );
        allow update: if accountIsActive(uid)
                      && (
                        isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                        || (
                          isSelf(uid)
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(["lastActivityAt", "lastResultId", "updatedAt"])
                        )
                      );
        allow delete: if accountIsActive(uid) && isAdmin();

        match /evaluaciones/{evaluationId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create: if accountIsActive(uid)
                        && validAdhdEvaluationCreate(programId, evaluationId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow update: if accountIsActive(uid)
                        && (
                          (
                            isSelf(uid)
                            && validAdhdEvaluationUpdate(programId, evaluationId, false)
                          )
                          || (
                            (isAdmin() || professionalCanEditPatient(uid, patientProfile(uid)))
                            && validAdhdEvaluationUpdate(programId, evaluationId, true)
                          )
                        );
          allow delete: if accountIsActive(uid)
                        && (
                          isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
        }

        match /perfiles/{profileId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create, update: if accountIsActive(uid)
                                && (
                                  isAdmin()
                                  || professionalCanEditPatient(uid, patientProfile(uid))
                                );
          allow delete: if accountIsActive(uid) && isAdmin();
        }

        match /planes/{planId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create, update: if accountIsActive(uid)
                                && (
                                  isAdmin()
                                  || professionalCanEditPatient(uid, patientProfile(uid))
                                );
          allow delete: if accountIsActive(uid) && isAdmin();
        }

        match /metas/{goalId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create: if accountIsActive(uid)
                        && validAdhdGoalCreate(programId, goalId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow update: if accountIsActive(uid)
                        && (
                          (
                            isSelf(uid)
                            && validPatientAdhdGoalUpdate(programId, goalId)
                          )
                          || (
                            (isAdmin() || professionalCanEditPatient(uid, patientProfile(uid)))
                            && validClinicalAdhdGoalUpdate(programId, goalId)
                          )
                        );
          allow delete: if accountIsActive(uid)
                        && (
                          isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
        }

        match /sesiones/{sessionId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create: if accountIsActive(uid)
                        && validAdhdSessionCreate(programId, sessionId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow update: if accountIsActive(uid)
                        && validAdhdSessionUpdate(programId, sessionId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow delete: if accountIsActive(uid)
                        && (
                          isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
        }

        match /retos/{challengeId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create: if accountIsActive(uid)
                        && validAdhdChallengeCreate(programId, challengeId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow update: if accountIsActive(uid)
                        && validAdhdChallengeUpdate(programId, challengeId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow delete: if accountIsActive(uid)
                        && (
                          isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
        }

        // Auditoría append-only. Ni el paciente ni el profesional pueden reescribirla.
        match /auditoria/{auditId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create: if accountIsActive(uid)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow update, delete: if false;
        }
      }

      // Resumen canónico compatible con los resultados de rehabilitación ya
      // existentes. La telemetría detallada vive en bloques, no en el resumen.
      match /rehabilitacionResultados/{resultId} {
        allow read: if accountIsActive(uid)
                    && (
                      isSelf(uid)
                      || isAdmin()
                      || professionalCanReadPatient(uid, patientProfile(uid))
                    );
        allow create: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                      )
                      && (
                        validLegacyRehabilitationResult(request.resource.data)
                        || validCanonicalAdhdResultCreate(uid, resultId)
                      );
        allow update: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                      )
                      && (
                        (
                          isCanonicalAdhdData(resource.data)
                          && validCanonicalAdhdResultUpdate(resultId)
                        )
                        || (
                          validLegacyRehabilitationResult(resource.data)
                          && validLegacyRehabilitationResult(request.resource.data)
                        )
                      );
        allow delete: if accountIsActive(uid)
                      && !isCanonicalAdhdData(resource.data)
                      && (
                        isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                      );

        match /telemetryBlocks/{blockId} {
          allow read: if accountIsActive(uid)
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanReadPatient(uid, patientProfile(uid))
                      );
          allow create: if accountIsActive(uid)
                        && validAdhdTelemetryCreate(uid, resultId)
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow update: if accountIsActive(uid)
                        && validAdhdTelemetryIdempotentUpdate()
                        && (
                          isSelf(uid)
                          || isAdmin()
                          || professionalCanEditPatient(uid, patientProfile(uid))
                        );
          allow delete: if false;
        }
      }

      match /{subcollection}/{subdocument=**} {
        allow read: if accountIsActive(uid)
                    && subcollection != "agenda"
                    && subcollection != "clinicalPatternProfiles"
                    && subcollection != "clinicalPatternReviews"
                    && subcollection != "cloudFiles"
                    && subcollection != "cloudStorageUsage"
                    && subcollection != "cloudUploadReservations"
                    && subcollection != "apuntesMedico"
                    && subcollection != "carpetasApuntes"
                    && subcollection != "permisosMedicos"
                    && subcollection != "patientQuotaAssignments"
                    && subcollection != "patientCreationOperations"
                    && subcollection != "rehabilitacionProgramas"
                    && subcollection != "rehabilitacionResultados"
                    && (
                      isSelf(uid)
                      || isAdmin()
                      || professionalCanReadPatient(uid, patientProfile(uid))
                    );
        allow create: if accountIsActive(uid)
                      && subcollection != "agenda"
                      && subcollection != "clinicalPatternProfiles"
                      && subcollection != "clinicalPatternReviews"
                      && subcollection != "cloudFiles"
                      && subcollection != "cloudStorageUsage"
                      && subcollection != "cloudUploadReservations"
                      && subcollection != "apuntesMedico"
                      && subcollection != "carpetasApuntes"
                      && subcollection != "permisosMedicos"
                      && subcollection != "patientQuotaAssignments"
                      && subcollection != "patientCreationOperations"
                      && subcollection != "rehabilitacionProgramas"
                      && subcollection != "rehabilitacionResultados"
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                        || (
                          isPatientNoteCollection(subcollection)
                          && professionalCanAddPatientNotes(uid, patientProfile(uid))
                        )
                      );
        allow update, delete: if accountIsActive(uid)
                              && subcollection != "agenda"
                              && subcollection != "clinicalPatternProfiles"
                              && subcollection != "clinicalPatternReviews"
                              && subcollection != "cloudFiles"
                              && subcollection != "cloudStorageUsage"
                              && subcollection != "cloudUploadReservations"
                              && subcollection != "apuntesMedico"
                              && subcollection != "carpetasApuntes"
                              && subcollection != "permisosMedicos"
                              && subcollection != "patientQuotaAssignments"
                              && subcollection != "patientCreationOperations"
                              && subcollection != "rehabilitacionProgramas"
                              && subcollection != "rehabilitacionResultados"
                              && (
                                isSelf(uid)
                                || isAdmin()
                                || professionalCanEditPatient(uid, patientProfile(uid))
                              );
      }

      // Mi nube: el propietario puede consultar su metadata. Todas las
      // mutaciones se realizan exclusivamente con Cloud Functions/Admin SDK.
      match /cloudFiles/{fileId} {
        allow read: if accountIsActive(uid) && isSelf(uid);
        allow create, update, delete: if false;
      }

      match /cloudStorageUsage/{usageId} {
        allow read: if accountIsActive(uid) && isSelf(uid) && usageId == "current";
        allow create, update, delete: if false;
      }

      // Las reservas contienen controles internos de cuota y no se exponen al cliente.
      match /cloudUploadReservations/{reservationId} {
        allow read, create, update, delete: if false;
      }

      // Mis apuntes conserva sus colecciones y escritura cliente actuales,
      // ahora limitada al UID propietario en vez del wildcard heredado.
      match /apuntesMedico/{noteId} {
        allow read: if accountIsActive(uid) && (isSelf(uid) || isAdmin());
        allow create, update: if accountIsActive(uid) && isSelf(uid);
        allow delete: if accountIsActive(uid) && (isSelf(uid) || isAdmin());
      }

      match /carpetasApuntes/{folderId} {
        allow read: if accountIsActive(uid) && (isSelf(uid) || isAdmin());
        allow create, update: if accountIsActive(uid) && isSelf(uid);
        allow delete: if accountIsActive(uid) && (isSelf(uid) || isAdmin());
      }

      // Las relaciones profesionales y los slots de cuota son server-only.
      // Un profesional solo consulta su propio permiso; el paciente, admin o
      // tratante con administrarPermisos pueden enumerar el equipo clínico.
      match /permisosMedicos/{professionalUid} {
        allow get: if accountIsActive(uid)
                   && (
                     isSelf(uid)
                     || isAdmin()
                     || professionalCanAdminPatient(uid, patientProfile(uid))
                     || (
                       professionalUid == request.auth.uid
                       && resource.data.get("lectura", false) == true
                       && isProfesionalClinico()
                       && isActivePatientRecord(patientProfile(uid))
                       && professionalPlanAllowsPatient(uid)
                     )
                   );
        allow list: if accountIsActive(uid)
                    && (
                      isSelf(uid)
                      || isAdmin()
                      || professionalCanAdminPatient(uid, patientProfile(uid))
                      || (
                        professionalUid == request.auth.uid
                        && resource.data.get("lectura", false) == true
                        && isProfesionalClinico()
                        && isActivePatientRecord(patientProfile(uid))
                        && professionalPlanAllowsPatient(uid)
                      )
                    );
        allow create, update, delete: if false;
      }

      match /patientQuotaAssignments/{patientUid} {
        // El profesional puede enumerar únicamente sus propios IDs asignados
        // para resolver lecturas concretas. El contenido y todas las
        // mutaciones siguen administrados exclusivamente por backend.
        allow get, list: if accountIsActive(uid) && isSelf(uid);
        allow create, update, delete: if false;
      }

      // Claves de idempotencia de alta: solo Admin SDK puede leerlas o mutarlas.
      match /patientCreationOperations/{operationId} {
        allow read, create, update, delete: if false;
      }
    }

    // Una marca de eliminación invalida de inmediato los tokens residuales.
    // Solo Admin SDK puede crear o consultar estos documentos internos.
    match /accountDeletionTombstones/{uid} {
      allow read, create, update, delete: if false;
    }

    /*
     * PACIENTES
     */
    match /pacientes/{uid} {
      allow read: if accountIsActive(uid)
                  && (
                    isSelf(uid)
                    || isAdmin()
                    || professionalCanReadPatient(uid, patientProfile(uid))
                  );
      allow write: if accountIsActive(uid)
                   && (
                     isSelf(uid)
                     || isAdmin()
                     || professionalCanEditPatient(uid, patientProfile(uid))
                   );

      match /{subcollection}/{subdocument=**} {
        allow read: if accountIsActive(uid)
                    && subcollection != "clinicalPatternProfiles"
                    && subcollection != "clinicalPatternReviews"
                    && (
                      isSelf(uid)
                      || isAdmin()
                      || professionalCanReadPatient(uid, patientProfile(uid))
                    );
        allow create: if accountIsActive(uid)
                      && subcollection != "clinicalPatternProfiles"
                      && subcollection != "clinicalPatternReviews"
                      && (
                        isSelf(uid)
                        || isAdmin()
                        || professionalCanEditPatient(uid, patientProfile(uid))
                        || (
                          isPatientNoteCollection(subcollection)
                          && professionalCanAddPatientNotes(uid, patientProfile(uid))
                        )
                      );
        allow update, delete: if accountIsActive(uid)
                              && subcollection != "clinicalPatternProfiles"
                              && subcollection != "clinicalPatternReviews"
                              && (
                                isSelf(uid)
                                || isAdmin()
                                || professionalCanEditPatient(uid, patientProfile(uid))
                              );
      }
    }

    /*
     * AVISOS
     */
    match /avisosGlobales/{avisoId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /*
     * AUDITORÍA
     */
    match /auditoria/{eventoId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    /*
     * REPORTES
     */
    match /reportesUsuarios/{reporteId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    /*
     * CÓDIGOS
     */
    match /codigosAutorizacionMedico/{codigoId} {
      // El registro profesional consume el código dentro de una transacción
      // Admin SDK. El navegador solo lo administra cuando ya es administrador.
      allow read, create, update, delete: if isAdmin();
    }

    match /codigosVinculacion/{codigoId} {
      // La vinculación de expedientes también se resuelve mediante callable;
      // los códigos de un solo uso nunca son accesibles desde el navegador.
      allow read, write: if false;
    }

    /*
     * FOROS
     */
    match /foros/{foroId}/{document=**} {
      allow read, write: if signedIn();
    }

    /*
     * ============================
     * CHAT (REGLA TEMPORAL)
     * ============================
     */

    match /mensajesConversaciones/{conversacionId} {

      allow read, create, update, delete: if signedIn();

      match /mensajes/{mensajeId} {
        allow read, create, update, delete: if signedIn();
      }

    }

    /*
     * BLOQUEO GENERAL
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
